---
import { ProyectosGrid } from "./ProyectosGrid";
import { EncryptedText } from "./ui/encrypted-text";
---

<section id="proyectos" class="bg-transparent py-24 text-white">
  <div class="container mx-auto px-6 max-w-6xl">
    <EncryptedText
      text="> PORTAFOLIO"
      client:visible
      className="text-xs block tracking-widest uppercase font-bold mb-4 text-gray-500"
      revealDelayMs={60}
    />
    <EncryptedText
      text="Proyectos"
      client:visible
      className="text-5xl block text-white tracking-widest font-bold mb-4"
      revealDelayMs={90}
    />

    <ProyectosGrid client:visible />
  </div>
</section>
