---
import Layout from "../layouts/Layout.astro";
import SectionInicio from "../components/section-inicio.astro";
import SectionAbout from "../components/section-about.astro";
import TechLeng from "../components/tech&leng.astro";
import Cards from "../components/cards.astro";
import Contacto from "../components/contacto.astro";
import Footer from "../components/footer.astro";
import { PageLoader } from "@/components/animations/PageLoader";
import { ScrollVelocity } from "@/components/animations/ScrollVelocity";
---

<Layout title="gl0wxyz | Portafolio">
  <main class="min-h-screen w-full">
    <PageLoader client:load/>
    <SectionInicio />

    <ScrollVelocity text="gl0w's • Portafolio • glow's • Portafolio" client:load />
    <ScrollVelocity text="gl0w's • Portafolio • gl0w's • Portafolio" baseVelocity={-2} client:load />
    
    <SectionAbout />
    <TechLeng />
    <Cards />
    <Contacto />
  </main>
  
  <Footer />
</Layout>
